# Copy this file to .env (or .env.local) and adjust the values.

# Public site domain, used for canonical URLs and meta tags
NEXT_PUBLIC_SITE_DOMAIN=localhost:3000
# Force a certain theme over the system preference: light or dark
# NEXT_PUBLIC_FORCE_DEFAULT_THEME=light
# Initial source language instead of the default auto
# NEXT_PUBLIC_DEFAULT_SOURCE_LANG=auto
# Initial target language instead of the default en
# NEXT_PUBLIC_DEFAULT_TARGET_LANG=en

# Only needed for local development against a standalone LibreTranslate
# instance (the Docker image runs LibreTranslate in the same container)
LIBRE_TRANSLATE_URL=http://127.0.0.1:5000
# API key, only needed if LibreTranslate is started with LT_API_KEYS
# LIBRE_TRANSLATE_API_KEY=

# docker-compose settings
# LINGVA_PORT=3000
# SITE_DOMAIN=localhost:3000
# Languages loaded by LibreTranslate and pre-downloaded into the Docker image
# LT_LOAD_ONLY=en,ru,de,fr,es,zh,ja,tr,ar
